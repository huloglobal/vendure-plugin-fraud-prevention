    "type": "git",
    "url": "git+https://github.com/huloglobal/vendure-plugin-fraud-prevention.git"
  },
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "ui",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "logo.svg",
    "hulo-global-logo.svg",
    "hulo-global-logo-light.svg",
    "hulo-global-logo-dark.svg"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepublishOnly": "yarn build",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@huloglobal/vendure-licence-sdk": "^0.15.6"
  },
  "peerDependencies": {
    "@nestjs/common": ">=10.0.0",
