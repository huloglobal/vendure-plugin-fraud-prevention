{
  "name": "@huloglobal/vendure-plugin-fraud-prevention",
  "version": "0.22.0",
  "description": "Fraud prevention for Vendure: every order is risk-scored on the server (velocity, lists, disposable emails, card AVS/CVC, Stripe Radar, 3-D Secure); block-level orders are refused before the charge, risky ones held for review.",
