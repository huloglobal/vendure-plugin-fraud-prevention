    "nodemailer": ">=6.0.0",
    "typeorm": ">=0.3.0"
  },
  "devDependencies": {
    "@nestjs/common": "^12.5.0",
    "@nestjs/schedule": "^12.0.4",
    "@types/node": "^20.0.0",
